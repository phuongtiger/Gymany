@model Gymany.Models.Customer
@{
    ViewData["Title"] = "MemberDetail";
}
@{
    Layout = "PTLayout";
}
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<body>
    <div style="padding-top: 50px;">
        <div class=" row bg-white shadow " style="padding: 30px;">
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.cus_username)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.cus_username)
            </dd>
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.cus_name)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.cus_name)
            </dd>
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.cus_address)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.cus_address)
            </dd>
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.cus_age)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.cus_age)
            </dd>
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.cus_image)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.cus_image)
            </dd>
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.cus_phone)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.cus_phone)
            </dd>
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.cus_email)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.cus_email)
            </dd>
        </div>
        <hr>
        <a asp-area="PT" asp-action="index" class="btn btn-outline-success btn-primary">Back</a>
    </div>

</body>