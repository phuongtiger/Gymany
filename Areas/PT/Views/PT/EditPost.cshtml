@model Gymany.Models.Post
@{
    ViewData["Title"] = "EditPost";
}
@{
    Layout = "PTLayout";
}
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
<div style="padding-top: 50px;"></div>
<div class="row bg-light p-12">
    <div class="col-md-12">
        <form asp-action="EditPost">
            <input type="hidden" asp-for="post_id">
            <div class="form-group">
                <label asp-for="post_title" class="control-label h3"></label>
                <input asp-for="post_title" class="form-control form-control-lg" />
                <span asp-validation-for="post_title" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="post_date" class="control-label h3"></label>
                <input readonly type="date" asp-for="post_date" class="form-control form-control-lg" />
            </div>
            <div class="form-group">
                <label asp-for="post_content" class="control-label h3"></label>
                <textarea asp-for="post_content" class="form-control form-control-lg text-justify"></textarea>
                <span asp-validation-for="post_content" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="post_img" class="control-label h3"></label>
                <input asp-for="post_img" class="form-control form-control-lg" />
                <span asp-validation-for="post_title" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input readonly type="hidden" asp-for="pt_id" class="form-control form-control-lg"/>              
            </div>
            <div class="form-group">
                <label asp-for="admin_id" class="control-label h3">StaffID</label>
                <input readonly asp-for="admin_id" class="form-control form-control-lg" />
            </div>
            <button type="submit" class="btn btn-primary btn-lg">Update</button>
        </form>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
<script>
    document.addEventListener('DOMContentLoaded', function () {
        ClassicEditor
            .create(document.querySelector('#Content'))
            .catch(error => {
                console.error(error);
            });
    });
</script>
