@model Gymany.Models.PersonalTrainer
@{
    ViewData["Title"] = "UpdatePtAccout";
}
@{
    Layout = "AdminLayout";
}
@* declare tag helper in areas *@
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
<div class="text-center">
    <h2 class="display-4">Update Personal Trainer</h2>
</div>
<form asp-controller="Admin" asp-action="UpdatePtAccount" method="post" class="container" style="max-width: 1100px;">

    <div class="form-group row">
        <label asp-for="pt_id" class="col-sm-2 col-form-label">Personal Trainer ID:</label>
        <div class="col-sm-10">
            <input type="text" asp-for="pt_id" value="@ViewBag.pt_id" class="form-control" readonly>
        </div>
    </div>

    <div class="form-group row">
        <label asp-for="pt_username" class="col-sm-2 col-form-label">Username:</label>
        <div class="col-sm-10">
            <input type="text" asp-for="pt_username" class="form-control" required>
        </div>
    </div>

    <div class="form-group row">
        <label asp-for="@Model.pt_password" class="col-sm-2 col-form-label">Password:</label>
        <div class="col-sm-10">
            <input type="text" asp-for="@Model.pt_password" class="form-control" required>
        </div>
    </div>

    <div class="form-group row">
        <label asp-for="pt_name" class="col-sm-2 col-form-label">Name:</label>
        <div class="col-sm-10">
            <input type="text" asp-for="pt_name" class="form-control" required>
        </div>
    </div>

    <div class="form-group row">
        <label asp-for="pt_age" class="col-sm-2 col-form-label">Age:</label>
        <div class="col-sm-10">
            <input type="date" asp-for="pt_age" class="form-control">
        </div>
    </div>

    <div class="form-group row">
        <label asp-for="pt_address" class="col-sm-2 col-form-label">Address:</label>
        <div class="col-sm-10">
            <input type="text" asp-for="pt_address" class="form-control">
        </div>
    </div>

    <div class="form-group row">
        <label asp-for="pt_salary" class="col-sm-2 col-form-label">Salary:</label>
        <div class="col-sm-10">
            <input type="number" asp-for="pt_salary" class="form-control" required min="1">
        </div>
    </div>

    <div class="form-group row">
        <label asp-for="pt_email" class="col-sm-2 col-form-label">Email:</label>
        <div class="col-sm-10">
            <input type="email" asp-for="pt_email" class="form-control" required>
        </div>
    </div>


    <div class="form-group row">
        <div class="col-sm-10 offset-sm-2">
            <input type="submit" value="submit" class="btn btn-primary">
            <a asp-action="PersonalTrainer" asp-controller="Admin" class="btn btn-danger">Back to Personal
                Trainer</a>
        </div>
    </div>

</form>