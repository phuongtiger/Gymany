@model Gymany.Models.Order
@{
    ViewData["Title"] = "UpdateOrder";
}

@{
    Layout = "GymOwnerLayout";
}
@* declare tag helper in areas *@
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<div class="text-center">
    <h2 class="display-4">Update Status Order</h2>
</div>
<form asp-controller="GymOwner" asp-action="UpdateOrder" method="post" class="container" style="max-width: 1100px;">


    <div class="form-group row">
        <label asp-for="order_id" class="col-sm-2 col-form-label">Order ID:</label>
        <div class="col-sm-10">
            <input type="number" asp-for="order_id" value="@ViewBag.order_id" class="form-control" readonly>
        </div>
    </div>

    <div class="form-group row">
        <label asp-for="cus_id" class="col-sm-2 col-form-label">Customer Name:</label>
        <div class="col-sm-10">
            <select asp-for="cus_id" class="form-control" asp-items="@ViewBag.cus_id" disabled></select>
            <input type="hidden" asp-for="cus_id" />
            <span asp-validation-for="cus_id" class="text-danger"></span>
        </div>
    </div>

    <div class="form-group row">
        <label asp-for="prod_id" class="col-sm-2 col-form-label">Product Name:</label>
        <div class="col-sm-10">
            <select asp-for="prod_id" class="form-control" asp-items="@ViewBag.Produprod_idctID" disabled></select>
            <input type="hidden" asp-for="prod_id" />
            <span asp-validation-for="prod_id" class="text-danger"></span>
        </div>
    </div>

    <div class="form-group row">
        <label asp-for="order_status" class="col-sm-2 col-form-label">Status:</label>
        <div class="col-sm-10">
            <select asp-for="order_status" class="form-control">
                <option value="Waiting">Waiting</option>
                <option value="Success">Success</option>
            </select>
            <span asp-validation-for="order_status" class="text-danger"></span>
        </div>
    </div>

    <div class="form-group row">
        <label asp-for="order_startDate" class="col-sm-2 col-form-label">StartDate:</label>
        <div class="col-sm-10">
            <input type="text" asp-for="order_startDate" value="@Model.order_startDate" class="form-control" readonly>
        </div>
    </div>
    <div class="form-group row">
        <label asp-for="order_totalPrice" class="col-sm-2 col-form-label">Total:</label>
        <div class="col-sm-10">
            <input type="number" asp-for="order_totalPrice" value="@Model.order_totalPrice" class="form-control" readonly>
        </div>
    </div>
    <div class="form-group row">
        <label asp-for="order_quantity" class="col-sm-2 col-form-label">Quantity:</label>
        <div class="col-sm-10">
            <input type="number" asp-for="order_quantity" value="@Model.order_quantity" class="form-control" readonly>
        </div>
    </div>


    <div class="form-group row">
        <div class="col-sm-10 offset-sm-2">
            <input type="submit" value="Update" class="btn btn-primary">
            <a asp-action="Order" asp-controller="GymOwner" class="btn btn-danger">Back to Order Manage</a>
        </div>
    </div>
</form>
