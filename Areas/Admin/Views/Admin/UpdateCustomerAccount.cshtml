@model Gymany.Models.Customer
@{
    ViewData["Title"] = "UpdateCustomerAccout";
}

@{
    Layout = "GymOwnerLayout";
}
@* declare tag helper in areas *@
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<div class="text-center">
    <h2 class="display-4">Update Customer</h2>
</div>
<form asp-controller="GymOwner" asp-action="UpdateCustomerAccount" method="post" class="container" style="max-width: 1100px;">

    <div class="form-group row">
        <label asp-for="cus_id" class="col-sm-2 col-form-label">Customer ID:</label>
        <div class="col-sm-10">
            <input type="text" asp-for="cus_id" value="@ViewBag.cus_id" class="form-control" readonly>
        </div>
    </div>

    <div class="form-group row">
        <label asp-for="cus_username" class="col-sm-2 col-form-label">Username:</label>
        <div class="col-sm-10">
            <input type="text" asp-for="cus_username" class="form-control" required>
        </div>
    </div>

    <div class="form-group row">
        <label asp-for="cus_password" class="col-sm-2 col-form-label">Password:</label>
        <div class="col-sm-10">
            <input type="text" asp-for="cus_password" class="form-control" required>
        </div>
    </div>

    <div class="form-group row">
        <label asp-for="cus_name" class="col-sm-2 col-form-label">Name:</label>
        <div class="col-sm-10">
            <input type="text" asp-for="cus_name" class="form-control" required>
        </div>
    </div>

    <div class="form-group row">
        <label asp-for="cus_address" class="col-sm-2 col-form-label">Address:</label>
        <div class="col-sm-10">
            <input type="text" asp-for="cus_address" class="form-control" required>
        </div>
    </div>

    <div class="form-group row">
        <label asp-for="cus_age" class="col-sm-2 col-form-label">Age:</label>
        <div class="col-sm-10">
            <input type="date" asp-for="cus_age" class="form-control">
        </div>
    </div>

    <div class="form-group row">
        <label asp-for="cus_image" class="col-sm-2 col-form-label">Image:</label>
        <div class="col-sm-10">
            <input type="text" asp-for="cus_image" class="form-control" required>
        </div>
    </div>

    <div class="form-group row">
        <label asp-for="cus_phone" class="col-sm-2 col-form-label">Phone:</label>
        <div class="col-sm-10">
            <input type="text" asp-for="cus_phone" class="form-control" required>
        </div>
    </div>

    <div class="form-group row">
        <label asp-for="cus_email" class="col-sm-2 col-form-label">Email:</label>
        <div class="col-sm-10">
            <input type="email" asp-for="cus_email" class="form-control" required>
        </div>
    </div>

    <div class="form-group row">
        <div class="col-sm-10 offset-sm-2">
            <input type="submit" value="Update" class="btn btn-primary">
            <a asp-action="CustomerAccount" asp-controller="GymOwner" class="btn btn-danger">Back to Customer</a>
        </div>
    </div>
</form>
