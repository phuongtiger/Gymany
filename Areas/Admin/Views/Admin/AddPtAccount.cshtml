@model Gymany.Models.PersonalTrainer
@{
    ViewData["Title"] = "AddPtAccout";
}
@{
    Layout = "GymOwnerLayout";
}
@* declare tag helper in areas *@
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
 <div class="text-center">
        <h2 class="display-4">Add Personal Trainer</h2>
    </div>
<form asp-controller="Admin" asp-action="AddPtAccount" method="post" class="container" style="max-width: 1100px;">
    <div class="form-group row">
        <label asp-for="pt_username" class="col-sm-2 col-form-label">Username:</label>
        <div class="col-sm-10">
            <input type="text" asp-for="pt_username" class="form-control">
            <span asp-validation-for="pt_username" class="text-danger"></span>
        </div>
    </div>

    <div class="form-group row">
        <label asp-for="pt_password" class="col-sm-2 col-form-label">Password:</label>
        <div class="col-sm-10">
            <input type="password" asp-for="pt_password" class="form-control">
            <span asp-validation-for="pt_password" class="text-danger"></span>
        </div>
    </div>

    <div class="form-group row">
        <label asp-for="pt_name" class="col-sm-2 col-form-label">Name:</label>
        <div class="col-sm-10">
            <input type="text" asp-for="pt_name" class="form-control">
            <span asp-validation-for="pt_name" class="text-danger"></span>
        </div>
    </div>

    <div class="form-group row">
        <label asp-for="pt_age" class="col-sm-2 col-form-label">Age:</label>
        <div class="col-sm-10">
            <input type="date" asp-for="pt_age" class="form-control">
            <span asp-validation-for="pt_age" class="text-danger"></span>
        </div>
    </div>

    <div class="form-group row">
        <label asp-for="pt_address" class="col-sm-2 col-form-label">Address:</label>
        <div class="col-sm-10">
            <input type="text" asp-for="pt_address" class="form-control">
            <span asp-validation-for="pt_address" class="text-danger"></span>
        </div>
    </div>

    <div class="form-group row">
        <label asp-for="pt_salary" class="col-sm-2 col-form-label">Salary:</label>
        <div class="col-sm-10">
            <input type="number" asp-for="pt_salary" class="form-control">
            <span asp-validation-for="pt_salary" class="text-danger"></span>
        </div>
    </div>

    <div class="form-group row">
        <label asp-for="pt_email" class="col-sm-2 col-form-label">Email:</label>
        <div class="col-sm-10">
            <input type="email" asp-for="pt_email" class="form-control">
            <span asp-validation-for="pt_email" class="text-danger"></span>
        </div>
    </div>


    <div class="form-group row">
        <div class="col-sm-10 offset-sm-2">
            <input type="submit" value="Submit" class="btn btn-primary">
            <a asp-action="PersonalTrainer" asp-controller="GymOwner" class="btn btn-danger">Back to Personal
                Trainer</a>
        </div>
    </div>
</form>