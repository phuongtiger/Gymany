@model Gymany.Models.Post
@{
    ViewData["Title"] = "AddPost";
}
@{
    Layout = "AdminLayout";
}
@* declare tag helper in areas *@
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

 <div class="text-center">
        <h2 class="display-4">Add Post</h2>
    </div>
<form asp-controller="Admin" asp-action="AddPost" method="post" class="container" style="max-width: 1100px;" enctype="multipart/form-data">
    <div class="form-group row">
        <label asp-for="post_date" class="col-sm-2 col-form-label">Date:</label>
        <div class="col-sm-10">
            <input readonly type="date" asp-for="post_date" class="form-control" value="@DateTime.Now">
            <span asp-validation-for="post_date" class="text-danger"></span>
        </div>
    </div>
    <div class="form-group row">
        <label asp-for="post_title" class="col-sm-2 col-form-label">Title:</label>
        <div class="col-sm-10">
            <textarea id="Title" asp-for="post_title"  class="form-control"></textarea>
            <span asp-validation-for="post_title" class="text-danger"></span>
        </div>
    </div>
    <div class="form-group row">
        <label asp-for="post_content" class="col-sm-2 col-form-label">Content:</label>
        <div class="col-sm-10">
            <textarea id="Content" asp-for="post_content" rows="5" class="form-control"></textarea>
            <span asp-validation-for="post_content" class="text-danger"></span>
        </div>
    </div>

    <div class="form-group row" style="display: none;">
        <label asp-for="post_img" class="col-sm-2 col-form-label">Image:</label>
        <div class="col-sm-10">
            <input type="text" asp-for="post_img" class="form-control">
            <span asp-validation-for="post_img" class="text-danger"></span>
        </div>
    </div>
    @* <div class="form-group row">
        <label asp-for="ImageUpload" class="col-sm-2 col-form-label">Upload Image:</label>
        <div class="col-sm-10">
            <input type="file" asp-for="ImageUpload" class="form-control" required>
            <span asp-validation-for="ImageUpload" class="text-danger"></span>
        </div>
    </div> *@
    <div class="form-group row">
        <label asp-for="pt_id" class="col-sm-2 col-form-label">PT Name:</label>
        <div class="col-sm-10">
            <select asp-for="pt_id" class="form-control" asp-items="@ViewBag.NamePT"></select>
            <span asp-validation-for="pt_id" class="text-danger"></span>
        </div>
    </div>


    <div class="form-group row">
        <label asp-for="admin_id" class="col-sm-2 col-form-label">Staff Name:</label>
        <div class="col-sm-10">
            <select asp-for="admin_id" class="form-control" asp-items="@ViewBag.NameStaff"></select>
            <span asp-validation-for="admin_id" class="text-danger"></span>
        </div>
    </div>
    <div class="form-group row">
        <div class="col-sm-10 offset-sm-2">
            <input type="submit" value="Submit" class="btn btn-primary">
            <a asp-action="Post" asp-controller="Admin" class="btn btn-danger">Back to Post</a>
        </div>
    </div>
</form>
<script>
    document.addEventListener('DOMContentLoaded', function () {
        var currentDate = new Date().toISOString().substr(0, 10);
        document.getElementById('Date').value = currentDate;
    });
</script>
<script>
        document.addEventListener('DOMContentLoaded', function () {
            ClassicEditor
                .create(document.querySelector('#Content'))
                .catch(error => {
                    console.error(error);
                });
        });
    </script>