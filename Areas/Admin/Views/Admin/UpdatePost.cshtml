@model Gymany.Models.Post
@{
    ViewData["Title"] = "UpdatePost";
}
@{
    Layout = "GymOwnerLayout";
}
@* declare tag helper in areas *@
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<div class="text-center">
    <h2 class="display-4">Update Post</h2>
</div>
<form asp-controller="GymOwner" asp-action="UpdatePost" method="post" class="container" style="max-width: 1100px;"
    enctype="multipart/form-data">

    <div class="form-group row">
        <label asp-for="post_id" class="col-sm-2 col-form-label">Post ID:</label>
        <div class="col-sm-10">
            <input type="text" asp-for="post_id" value="@ViewBag.post_id" class="form-control" readonly>
        </div>
    </div>
    <div class="form-group row">
        <label asp-for="@Model.post_date" class="col-sm-2 col-form-label">Date:</label>
        <div class="col-sm-10">
            <input type="text" asp-for="@Model.post_date" class="form-control" required>
        </div>
    </div>

    <div class="form-group row">
        <label asp-for="post_content" class="col-sm-2 col-form-label">Content:</label>
        <div class="col-sm-10">
            <textarea id="Content" type="text" asp-for="post_content" class="form-control" required></textarea>
        </div>
    </div>

    <div class="form-group row">
        <label asp-for="@Model.post_title" class="col-sm-2 col-form-label">Title:</label>
        <div class="col-sm-10">
            <input type="text" asp-for="@Model.post_title" class="form-control" required>
        </div>
    </div>

    <div class="form-group row">
        <label asp-for="post_img" class="col-sm-2 col-form-label">Image:</label>
        <div class="col-sm-10">
            <input type="text" asp-for="post_img" class="form-control" required>
        </div>
    </div>
    @* <div class="form-group row">
        <label asp-for="ImageUpload" class="col-sm-2 col-form-label">Upload Image:</label>
        <div class="col-sm-10">
            <input type="file" asp-for="ImageUpload" class="form-control" required>
            <span asp-validation-for="ImageUpload" class="text-danger"></span>
        </div>
    </div> *@
    <div class="form-group row">
        <label asp-for="pt_id" class="col-sm-2 col-form-label">PT Name:</label>
        <div class="col-sm-10">
            <select asp-for="pt_id" class="form-control" asp-items="@ViewBag.NamePT"></select>
            <span asp-validation-for="pt_id" class="text-danger"></span>
        </div>
    </div>
    <div class="form-group row">
        <label asp-for="admin_id" class="col-sm-2 col-form-label">Staff Name:</label>
        <div class="col-sm-10">
            <select asp-for="admin_id" class="form-control" asp-items="@ViewBag.NameStaff"></select>
            <span asp-validation-for="admin_id" class="text-danger"></span>
        </div>
    </div>


    <div class="form-group row">
        <div class="col-sm-10 offset-sm-2">
            <input type="submit" value="Update" class="btn btn-primary">
            <a asp-action="Post" asp-controller="GymOwner" class="btn btn-danger" style="color: #fff;">Back to Post</a>
        </div>

    </div>
</form>
<script>
    document.addEventListener('DOMContentLoaded', function () {
        ClassicEditor
            .create(document.querySelector('#Content'))
            .catch(error => {
                console.error(error);
            });
    });
</script>