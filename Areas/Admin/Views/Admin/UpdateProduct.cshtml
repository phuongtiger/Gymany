@model Gymany.Models.Product
@{
    ViewData["Title"] = "UpdateProduct";
}
@{
    Layout = "GymOwnerLayout";
}
@* declare tag helper in areas *@
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<div class="text-center">
    <h2 class="display-4">Update Product</h2>
</div>
<form asp-controller="GymOwner" asp-action="UpdateProduct" method="post" class="container" style="max-width: 1100px;"
    enctype="multipart/form-data">

    <div class="form-group row">
        <label asp-for="prod_id" class="col-sm-2 col-form-label">Product ID:</label>
        <div class="col-sm-10">
            <input type="text" asp-for="prod_id" value="@ViewBag.ProductID" class="form-control" readonly>
        </div>
    </div>
    <div class="form-group row">
        <label asp-for="prod_name" class="col-sm-2 col-form-label">Name:</label>
        <div class="col-sm-10">
            <input type="text" asp-for="prod_name" class="form-control" required>
            <span asp-validation-for="prod_name" class="text-danger"></span>
        </div>
    </div>

    <div class="form-group row">
        <label asp-for="prod_description" class="col-sm-2 col-form-label">Description:</label>
        <div class="col-sm-10">
            <input type="text" asp-for="prod_description" class="form-control" required>
            <span asp-validation-for="prod_description" class="text-danger"></span>
        </div>
    </div>

    <div class="form-group row">
        <label asp-for="prod_amount" class="col-sm-2 col-form-label">Amount:</label>
        <div class="col-sm-10">
            <input type="number" asp-for="prod_amount" class="form-control" required min="1">
            <span asp-validation-for="prod_amount" class="text-danger"></span>
        </div>
    </div>

    <div class="form-group row">
        <label asp-for="prod_img" class="col-sm-2 col-form-label">Image:</label>
        <div class="col-sm-10">
            <input type="text" asp-for="prod_img" class="form-control" readonly>
        </div>
    </div>
    @* <div class="form-group row">
        <label asp-for="ImageUpload" class="col-sm-2 col-form-label">Upload Image:</label>
        <div class="col-sm-10">
            <input type="file" asp-for="ImageUpload" class="form-control" required>
            <span asp-validation-for="ImageUpload" class="text-danger"></span>
        </div>
    </div> *@
    <div class="form-group row">
        <label asp-for="prod_price" class="col-sm-2 col-form-label">Price:</label>
        <div class="col-sm-10">
            <input type="number" asp-for="prod_price" class="form-control" required min="1">
            <span asp-validation-for="prod_price" class="text-danger"></span>
        </div>
    </div>

    <div class="form-group row">
        <label asp-for="cate_id" class="col-sm-2 col-form-label">Type of Category</label>
        <div class="col-sm-10">
            <select asp-for="cate_id" class="form-control" asp-items="@ViewBag.CategoryID"></select>
        </div>
    </div>

    <div class="form-group row">
        <div class="col-sm-10 offset-sm-2">
            <input type="submit" value="Update" class="btn btn-primary">
            <a asp-action="Product" asp-controller="GymOwner" class="btn btn-danger" style="color: #fff;">Back to
                Product</a>
        </div>

    </div>
</form>