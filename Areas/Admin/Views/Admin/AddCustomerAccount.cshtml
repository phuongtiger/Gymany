@model Gymany.Models.Customer
@{
    ViewData["Title"] = "AddCustomer";
}
@{
    Layout = "AdminLayout";
}
@* declare tag helper in areas *@
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

 <div class="text-center">
        <h2 class="display-4">Add Customer</h2>
    </div>
<form asp-controller="Admin" asp-action="AddCustomerAccount" method="post" class="container" style="max-width: 1100px;">
    <div class="form-group row">
        <label asp-for="cus_username" class="col-sm-2 col-form-label">Username:</label>
        <div class="col-sm-10">
            <input type="text" asp-for="cus_username" class="form-control">
            <span asp-validation-for="cus_username" class="text-danger"></span>
        </div>
    </div>

    <div class="form-group row">
        <label asp-for="cus_password" class="col-sm-2 col-form-label">Password:</label>
        <div class="col-sm-10">
            <input type="password" asp-for="cus_password" class="form-control">
            <span asp-validation-for="cus_password" class="text-danger"></span>
        </div>
    </div>
    @* <div class="form-group row">
        <label asp-for="ConfirmPassword" class="col-sm-2 col-form-label">Confirm password</label>
        <div class="col-sm-10">
            <input type="password" asp-for="ConfirmPassword" class="form-control">
            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
        </div>
    </div> *@

    <div class="form-group row">
        <label asp-for="cus_name" class="col-sm-2 col-form-label">Name:</label>
        <div class="col-sm-10">
            <input type="text" asp-for="cus_name" class="form-control">
            <span asp-validation-for="cus_name" class="text-danger"></span>
        </div>
    </div>

    <div class="form-group row">
        <label asp-for="cus_address" class="col-sm-2 col-form-label">Address:</label>
        <div class="col-sm-10">
            <input type="text" asp-for="cus_address" class="form-control">
            <span asp-validation-for="cus_address" class="text-danger"></span>
        </div>
    </div>

    <div class="form-group row">
        <label asp-for="cus_age" class="col-sm-2 col-form-label">Age:</label>
        <div class="col-sm-10">
            <input type="date" asp-for="cus_age" class="form-control">
            <span asp-validation-for="cus_age" class="text-danger"></span>
        </div>
    </div>
    <div class="form-group row">
        <label asp-for="cus_image" class="col-sm-2 col-form-label">Image:</label>
        <div class="col-sm-10">
            <input type="text" asp-for="cus_image" class="form-control">
            <span asp-validation-for="cus_image" class="text-danger"></span>
        </div>
    </div>
    <div class="form-group row">
        <label asp-for="cus_phone" class="col-sm-2 col-form-label">Phone:</label>
        <div class="col-sm-10">
            <input type="tel" asp-for="cus_phone" class="form-control">
            <span asp-validation-for="cus_phone" class="text-danger"></span>
        </div>
    </div>
    <div class="form-group row">
        <label asp-for="cus_email" class="col-sm-2 col-form-label">Email:</label>
        <div class="col-sm-10">
            <input type="email" asp-for="cus_email" class="form-control">
            <span asp-validation-for="cus_email" class="text-danger"></span>
        </div>
    </div>

    <div class="form-group row">
        <div class="col-sm-10 offset-sm-2">
            <input type="submit" value="Submit" class="btn btn-primary">
            <a asp-action="CustomerAccount" asp-controller="Admin" class="btn btn-danger">Back to Customer</a>
        </div>
    </div>
</form>